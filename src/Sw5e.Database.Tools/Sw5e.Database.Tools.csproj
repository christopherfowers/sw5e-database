<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Sw5e.Database.Schemas\Sw5e.Database.Schemas.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The importer's repair rules are tested from the test project. They stay
      internal because nothing outside this tool has any business calling them:
      content is repaired once, on import, and every consumer downstream reads
      the repaired documents.
    -->
    <InternalsVisibleTo Include="Sw5e.Database.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
